# AI Logistics Assistant Configuration

# LLM Provider (ollama, openai, groq, anthropic)
LLM_PROVIDER=ollama

# Ollama Configuration (Local - Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (Optional)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# Application Settings
APP_NAME=AI Logistics Assistant
LOG_LEVEL=INFO

# Feature 6 Part B: Multi-tenant isolation. When true, tenant-scoped endpoints
# require X-Tenant-ID and sessions/documents/searches are isolated by tenant.
ENABLE_MULTI_TENANT=false

# Feature 6 Part C: Retrieval memory. When true, Smart Chat injects a digest
# of previous retrieval patterns into future generation prompts.
ENABLE_LONG_TERM_CONTEXT=false

# Embeddings: set to true ONLY on networks that block HuggingFace Hub (e.g.
# corporate proxies with TLS interception) AND you've already downloaded the
# all-MiniLM-L6-v2 model once. Leave false/unset on CI and fresh machines so
# the model can download normally on first use.
EMBEDDINGS_OFFLINE_MODE=false
